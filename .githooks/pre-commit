#!/usr/bin/env bash
# NO-COLLISION guard (Vinta directive 2026-08-02): block any commit that
# reintroduces a hardcoded fixed corner widget.
#
# The trigger used to be '^body/.*\.js$', which missed the top-level page scripts
# — and brain.js is exactly where #consciousness-brain-btn, #voiceToggle,
# #soul-bond-indicator and the consolidate toast all hardcoded their corners. The
# lint now scans body/**/*.js recursively plus those page scripts, so the hook
# has to fire for them too or the guard has a hole the size of the biggest file.
if git diff --cached --name-only | grep -qE '^(body/.*\.js|brain\.js|brain_expansion\.js|dirrm-launch\.js)$'; then
  node "$(git rev-parse --show-toplevel)/scripts/lint-no-collision.js" --quiet || {
    echo "commit blocked by no-collision lint (see above). Fix, or 'git commit --no-verify' to override.";
    exit 1;
  }
fi
exit 0
