+
+const GALAXY = { tasks:[], nodes:[], scale:1, ox:0, oy:0, drag:null };
+function galaxyStatus(t){ return String(t.status||'todo').replace(/[^a-z-]/g,'') || 'todo'; }
+function galaxyBuild(tasks){
+  const live = (tasks||[]).filter(t=>!t.archived && t.status!=='cancelled');
+  const byProject = new Map();
+  live.forEach(t=>{ const k=t.project||'Council'; if(!byProject.has(k)) byProject.set(k,[]); byProject.get(k).push(t); });
+  const projects=[...byProject.entries()];
+  const nodes=[]; const radiusBase=185;
+  projects.forEach(([project,items],pi)=>{
+    const orbit = radiusBase + pi*82;
+    const phase = (pi/projects.length) * Math.PI * 2;
+    nodes.push({type:'project', id:'p-'+pi, label:project, x:Math.cos(phase)*orbit*.42, y:Math.sin(phase)*orbit*.28, size:34, project});
+    items.forEach((t,ti)=>{
+      const a = phase + (ti/items.length)*Math.PI*2 + .34;
+      const r = orbit + (ti%4)*22;
+      const pr = Math.max(1, Math.min(5, parseInt(t.priority,10)||3));
+      nodes.push({type:'task', id:t.id, task:t, label:t.title||t.id, status:galaxyStatus(t),
+        x:Math.cos(a)*r, y:Math.sin(a)*r*.72, size:Math.max(18, 34 - pr*2), project});
+    });
+  });
+  GALAXY.nodes = nodes;
+}
+function galaxyScreen(n, rect){
+  return { x:rect.width/2 + GALAXY.ox + n.x*GALAXY.scale, y:rect.height/2 + GALAXY.oy + n.y*GALAXY.scale };
+}
+function renderGalaxy(){
+  const stage=document.getElementById('galaxyStage'), canvas=document.getElementById('galaxyCanvas'), wrap=document.getElementById('galaxyNodes');
+  if(!stage || !canvas || !wrap) return;
+  const rect=stage.getBoundingClientRect(), dpr=window.devicePixelRatio||1;
+  canvas.width=Math.max(1,Math.floor(rect.width*dpr)); canvas.height=Math.max(1,Math.floor(rect.height*dpr));
+  const ctx=canvas.getContext('2d'); ctx.setTransform(dpr,0,0,dpr,0,0); ctx.clearRect(0,0,rect.width,rect.height);
+  const stars=90; ctx.fillStyle='rgba(255,236,196,.72)';
+  for(let i=0;i<stars;i++){ const x=(i*73%997)/997*rect.width, y=(i*131%719)/719*rect.height, a=.18+((i*17)%70)/100; ctx.globalAlpha=a; ctx.fillRect(x,y,1.2,1.2); }
+  ctx.globalAlpha=1;
+  const projectNodes=GALAXY.nodes.filter(n=>n.type==='project');
+  const taskNodes=GALAXY.nodes.filter(n=>n.type==='task');
+  projectNodes.forEach(p=>{
+    const ps=galaxyScreen(p,rect);
+    ctx.strokeStyle='rgba(245,166,35,.13)'; ctx.lineWidth=1;
+    ctx.beginPath(); ctx.ellipse(rect.width/2+GALAXY.ox,rect.height/2+GALAXY.oy,Math.abs(p.x)*2.2*GALAXY.scale+80,Math.abs(p.y)*2.2*GALAXY.scale+90,0,0,Math.PI*2); ctx.stroke();
+    taskNodes.filter(n=>n.project===p.project).forEach(t=>{
+      const ts=galaxyScreen(t,rect);
+      ctx.strokeStyle=t.status==='done'?'rgba(20,184,166,.32)':t.status==='doing'||t.status==='claimed'?'rgba(245,166,35,.34)':'rgba(139,92,246,.22)';
+      ctx.lineWidth=t.status==='done'?1.7:1;
+      ctx.beginPath(); ctx.moveTo(ps.x,ps.y); ctx.quadraticCurveTo((ps.x+ts.x)/2, (ps.y+ts.y)/2-28, ts.x,ts.y); ctx.stroke();
+    });
+  });
+  wrap.innerHTML = GALAXY.nodes.map(n=>{
+    const p=galaxyScreen(n,rect), sz=(n.type==='project'?n.size:n.size)*GALAXY.scale;
+    const cls=n.type==='project'?'done':n.status;
+    const title=n.type==='project' ? n.label : `${n.id} · ${n.status} · ${n.label}`;
+    return `<button type="button" class="g-node ${esc(cls)}" data-id="${esc(n.id)}" style="left:${p.x}px;top:${p.y}px;--sz:${Math.max(16,Math.min(54,sz))}px" title="${esc(title)}" aria-label="${esc(title)}"><span class="g-core"></span><span class="g-label">${esc(n.label)}</span></button>`;
+  }).join('');
+  const empty=document.getElementById('galaxyEmpty'); if(empty) empty.hidden=!!GALAXY.nodes.length;
+}
+async function loadGalaxy(){
+  const r=await (await fetch('/api/tasks')).json(); GALAXY.tasks=r.tasks||[];
+  galaxyBuild(GALAXY.tasks); renderGalaxy();
+  const live=GALAXY.tasks.filter(t=>!t.archived && t.status!=='cancelled');
+  const projects=new Set(live.map(t=>t.project||'Council'));
+  const agents=new Set(live.map(t=>t.chosen_agent||t.assignee||t.claimed_by).filter(Boolean));
+  const done=live.filter(t=>t.status==='done').length;
+  const read=document.getElementById('galaxyReadout');
+  if(read) read.innerHTML = [
+    ['Bodies', live.length], ['Constellations', projects.size], ['Council signals', agents.size], ['Finished stars', done]
+  ].map(x=>`<div class="g-stat"><b>${x[1]}</b><span>${x[0]}</span></div>`).join('');
+}
+document.getElementById('galaxyNodes')?.addEventListener('click', e=>{
+  const b=e.target.closest('.g-node'); if(!b) return;
+  const n=GALAXY.nodes.find(x=>x.id===b.dataset.id);
+  if(n && n.type==='task') openDrawer(n.id);
+});
+document.getElementById('galZoomIn')?.addEventListener('click',()=>{ GALAXY.scale=Math.min(2.4,GALAXY.scale+.18); renderGalaxy(); });
+document.getElementById('galZoomOut')?.addEventListener('click',()=>{ GALAXY.scale=Math.max(.55,GALAXY.scale-.18); renderGalaxy(); });
+document.getElementById('galReset')?.addEventListener('click',()=>{ GALAXY.scale=1; GALAXY.ox=0; GALAXY.oy=0; renderGalaxy(); });
+window.addEventListener('resize',()=>{ if(VIEW==='galaxy') renderGalaxy(); });
