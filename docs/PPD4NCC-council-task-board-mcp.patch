index 0000000..0cbd858
--- /dev/null
+++ b/mcp/council-task-board-server.js
@@ -0,0 +1,333 @@
+'use strict';
+
+const fs = require('fs');
+const path = require('path');
+const { execFileSync } = require('child_process');
+
+const HOME = process.env.HOME || '/home/vinta';
+const COUNCIL_ROOT = process.env.COUNCIL_LOOP_ROOT || path.join(HOME, '.claude', 'council-loop');
+const VINTASK = process.env.VINTASK_JS || path.join(COUNCIL_ROOT, 'bin', 'vintask.js');
+const STATE_DIR = process.env.VINTASK_STATE || path.join(COUNCIL_ROOT, 'state');
+const TASKS_FILE = path.join(STATE_DIR, 'tasks.jsonl');
+const NODE = process.execPath;
+const MAX_TEXT = 8000;
+
+function clampText(v, max = MAX_TEXT) {
+  return String(v == null ? '' : v).replace(/\r/g, '').slice(0, max);
+}
+
+function taskSummary(t) {
+  return {
+    id: t.id,
+    project: t.project || '',
+    title: t.title || '',
+    status: t.status || '',
+    priority: t.priority || null,
+    chosen_agent: t.chosen_agent || t.assignee || '',
+    progress: t.progress || '',
+    percent: t.percent == null ? null : t.percent,
+    updated_at: t.updated_at || 0,
+    created_at: t.created_at || 0,
+    archived: !!t.archived,
+  };
+}
+
+function readTasks() {
+  let raw = '';
+  try { raw = fs.readFileSync(TASKS_FILE, 'utf8'); } catch { return []; }
+  return raw.split('\n')
+    .filter(Boolean)
+    .map(line => {
+      try { return JSON.parse(line); } catch { return null; }
+    })
+    .filter(Boolean);
+}
+
+function filterTasks(input = {}) {
+  const project = clampText(input.project, 160).toLowerCase();
+  const status = clampText(input.status, 80).toLowerCase();
+  const query = clampText(input.query, 500).toLowerCase();
+  const includeArchived = !!input.include_archived;
+  const limit = Math.max(1, Math.min(Number(input.limit) || 25, 100));
+  let tasks = readTasks();
+  if (!includeArchived) tasks = tasks.filter(t => !t.archived);
+  if (project) tasks = tasks.filter(t => String(t.project || '').toLowerCase() === project);
+  if (status) tasks = tasks.filter(t => String(t.status || '').toLowerCase() === status);
+  if (query) {
+    tasks = tasks.filter(t => [
+      t.id, t.project, t.title, t.detail, t.acceptance, t.progress,
+      t.blocked_reason, t.needs, t.chosen_agent, t.assignee,
+    ].filter(Boolean).join('\n').toLowerCase().includes(query));
+  }
+  tasks.sort((a, b) => {
+    const pa = Number(a.priority || 999);
+    const pb = Number(b.priority || 999);
+    if (pa !== pb) return pa - pb;
+    return Number(b.updated_at || b.created_at || 0) - Number(a.updated_at || a.created_at || 0);
+  });
+  return tasks.slice(0, limit).map(taskSummary);
+}
+
+function runVintask(args) {
+  const out = execFileSync(NODE, [VINTASK, ...args], {
+    cwd: COUNCIL_ROOT,
+    encoding: 'utf8',
+    timeout: 30_000,
+    env: { ...process.env, FORCE_COLOR: '0' },
+  });
+  return String(out || '').replace(/\x1b\[[0-9;]*m/g, '').trim();
+}
+
+function toolResult(value, isError = false) {
+  return {
+    content: [{ type: 'text', text: typeof value === 'string' ? value : JSON.stringify(value, null, 2) }],
+    isError,
+  };
+}
+
+const tools = [
+  {
+    name: 'council_tasks_list',
+    description: 'List Council Task Board tasks from the live vintask queue.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        project: { type: 'string', description: 'Exact project name filter.' },
+        status: { type: 'string', description: 'Exact status filter such as todo, doing, blocked, needs-human, done.' },
+        query: { type: 'string', description: 'Case-insensitive search over task text.' },
+        include_archived: { type: 'boolean', description: 'Include archived tasks. Defaults false.' },
+        limit: { type: 'number', description: 'Maximum tasks to return, 1-100. Defaults 25.' },
+      },
+      additionalProperties: false,
+    },
+  },
+  {
+    name: 'council_task_get',
+    description: 'Read one live task record by id.',
+    inputSchema: {
+      type: 'object',
+      required: ['id'],
+      properties: { id: { type: 'string' } },
+      additionalProperties: false,
+    },
+  },
+  {
+    name: 'council_task_add',
+    description: 'Queue a new council task through vintask add.',
+    inputSchema: {
+      type: 'object',
+      required: ['title'],
+      properties: {
+        title: { type: 'string' },
+        project: { type: 'string' },
+        detail: { type: 'string' },
+        acceptance: { type: 'string' },
+        priority: { type: 'number' },
+        agent: { type: 'string', description: 'Named council agent, not a seat.' },
+      },
+      additionalProperties: false,
+    },
+  },
+  {
+    name: 'council_task_progress',
+    description: 'Post a short progress update to a task.',
+    inputSchema: {
+      type: 'object',
+      required: ['id', 'progress'],
+      properties: {
+        id: { type: 'string' },
+        progress: { type: 'string' },
+        percent: { type: 'number', description: '0-100 when known.' },
+      },
+      additionalProperties: false,
+    },
+  },
+  {
+    name: 'council_task_action',
+    description: 'Run a guarded vintask lifecycle action. Done still requires proof.',
+    inputSchema: {
+      type: 'object',
+      required: ['id', 'action'],
+      properties: {
+        id: { type: 'string' },
+        action: { type: 'string', enum: ['done', 'block', 'need', 'cancel', 'reopen', 'pin', 'unpin'] },
+        text: { type: 'string', description: 'Reason/question for block, need, cancel, or reopen.' },
+        proof: { type: 'string', description: 'Required when action is done.' },
+      },
+      additionalProperties: false,
+    },
+  },
+];
+
+function callTool(name, input = {}) {
+  if (name === 'council_tasks_list') return toolResult({ tasks: filterTasks(input), source: TASKS_FILE });
+
+  if (name === 'council_task_get') {
+    const id = clampText(input.id, 64).trim();
+    const task = readTasks().find(t => t.id === id);
+    return task ? toolResult({ task }) : toolResult({ error: `No task ${id}` }, true);
+  }
+
+  if (name === 'council_task_add') {
+    const title = clampText(input.title, 500).trim();
+    if (!title) return toolResult({ error: 'title is required' }, true);
+    const args = ['add', title];
+    if (input.project) args.push('--project', clampText(input.project, 160));
+    if (input.detail) args.push('--detail', clampText(input.detail));
+    if (input.acceptance) args.push('--acceptance', clampText(input.acceptance));
+    if (input.priority != null) args.push('--priority', String(Math.max(1, Math.min(Number(input.priority) || 3, 5))));
+    if (input.agent) args.push('--agent', clampText(input.agent, 120));
+    return toolResult({ ok: true, out: runVintask(args) });
+  }
+
+  if (name === 'council_task_progress') {
+    const id = clampText(input.id, 64).trim();
+    const progress = clampText(input.progress, 300).trim();
+    if (!id || !progress) return toolResult({ error: 'id and progress are required' }, true);
+    const args = ['update', id, '--progress', progress];
+    if (input.percent != null) args.push('--percent', String(Math.max(0, Math.min(Number(input.percent) || 0, 100))));
+    return toolResult({ ok: true, out: runVintask(args) });
+  }
+
+  if (name === 'council_task_action') {
+    const id = clampText(input.id, 64).trim();
+    const action = clampText(input.action, 30).trim();
+    if (!id || !action) return toolResult({ error: 'id and action are required' }, true);
+    if (action === 'done') {
+      const proof = clampText(input.proof, 1000).trim();
+      if (!proof) return toolResult({ error: 'done requires proof' }, true);
+      return toolResult({ ok: true, out: runVintask(['done', id, '--proof', proof]) });
+    }
+    if (action === 'block') return toolResult({ ok: true, out: runVintask(['block', id, clampText(input.text, 1000).trim() || 'blocked via council MCP']) });
+    if (action === 'need') return toolResult({ ok: true, out: runVintask(['need', id, clampText(input.text, 1000).trim() || 'needs human decision via council MCP']) });
+    if (action === 'cancel') return toolResult({ ok: true, out: runVintask(['cancel', id, clampText(input.text, 1000).trim() || 'cancelled via council MCP']) });
+    if (action === 'reopen') return toolResult({ ok: true, out: runVintask(['reopen', id, clampText(input.text, 1000).trim()]) });
+    if (action === 'pin' || action === 'unpin') return toolResult({ ok: true, out: runVintask([action, id]) });
+    return toolResult({ error: `unsupported action ${action}` }, true);
+  }
+
+  return toolResult({ error: `unknown tool ${name}` }, true);
+}
+
+function resourceList() {
+  return {
+    resources: [
+      {
+        uri: 'council://tasks/current',
+        name: 'Current Council Task Queue',
+        description: 'Live non-archived task summaries from the Council Task Board.',
+        mimeType: 'application/json',
+      },
+    ],
+  };
+}
+
+function readResource(uri) {
+  if (uri !== 'council://tasks/current') throw new Error(`unknown resource ${uri}`);
+  return {
+    contents: [{
+      uri,
+      mimeType: 'application/json',
+      text: JSON.stringify({ tasks: filterTasks({ limit: 100 }), source: TASKS_FILE }, null, 2),
+    }],
+  };
+}
+
+function handleMessage(msg) {
+  if (!msg || typeof msg !== 'object') throw new Error('message must be an object');
+  const { id, method, params } = msg;
+  if (!method || method.startsWith('notifications/')) return null;
+  try {
+    let result;
+    if (method === 'initialize') {
+      result = {
+        protocolVersion: '2024-11-05',
+        capabilities: { tools: {}, resources: {} },
+        serverInfo: { name: 'council-task-board', version: '1.0.0' },
+      };
+    } else if (method === 'tools/list') {
+      result = { tools };
+    } else if (method === 'tools/call') {
+      result = callTool(params && params.name, (params && params.arguments) || {});
+    } else if (method === 'resources/list') {
+      result = resourceList();
+    } else if (method === 'resources/read') {
+      result = readResource(params && params.uri);
+    } else if (method === 'prompts/list') {
+      result = { prompts: [] };
+    } else {
+      return { jsonrpc: '2.0', id, error: { code: -32601, message: `Method not found: ${method}` } };
+    }
+    return id == null ? null : { jsonrpc: '2.0', id, result };
+  } catch (e) {
+    return { jsonrpc: '2.0', id, error: { code: -32000, message: String(e && e.message || e) } };
+  }
+}
+
+function writeMessage(obj) {
+  if (!obj) return;
+  process.stdout.write(frameMessage(obj));
+}
+
+function frameMessage(obj) {
+  const body = JSON.stringify(obj);
+  return `Content-Length: ${Buffer.byteLength(body, 'utf8')}\r\n\r\n${body}`;
+}
+
+function splitMessages(buffer) {
+  const messages = [];
+  let rest = buffer;
+  while (rest.length) {
+    const headerEnd = rest.indexOf('\r\n\r\n');
+    if (headerEnd >= 0 && /^Content-Length:/i.test(rest.slice(0, headerEnd))) {
+      const m = rest.slice(0, headerEnd).match(/Content-Length:\s*(\d+)/i);
+      if (!m) break;
+      const len = Number(m[1]);
+      const start = headerEnd + 4;
+      if (rest.length < start + len) break;
+      messages.push(rest.slice(start, start + len));
+      rest = rest.slice(start + len);
+      continue;
+    }
+    const nl = rest.indexOf('\n');
+    if (nl < 0) break;
+    const line = rest.slice(0, nl).trim();
+    rest = rest.slice(nl + 1);
+    if (line) messages.push(line);
+  }
+  return { messages, rest };
+}
+
+function main() {
+  let buffer = '';
+  const consume = () => {
+    const parsed = splitMessages(buffer);
+    buffer = parsed.rest;
+    for (const raw of parsed.messages) {
+      try { writeMessage(handleMessage(JSON.parse(raw))); }
+      catch (e) { writeMessage({ jsonrpc: '2.0', id: null, error: { code: -32700, message: String(e && e.message || e) } }); }
+    }
+  };
+  process.stdin.setEncoding('utf8');
+  process.stdin.on('data', chunk => {
+    buffer += chunk;
+    consume();
+  });
+  process.stdin.on('end', () => {
+    if (buffer.trim()) buffer += '\n';
+    consume();
+  });
+}
+
+if (require.main === module) main();
+
+module.exports = {
+  callTool,
+  filterTasks,
+  frameMessage,
+  handleMessage,
+  readTasks,
+  resourceList,
+  readResource,
+  tools,
+};
