@@ -0,0 +1,75 @@
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+
+const root = path.resolve(__dirname, '..');
+const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'council-mcp-'));
+const tasksPath = path.join(tmp, 'tasks.jsonl');
+process.env.VINTASK_STATE = tmp;
+fs.writeFileSync(tasksPath, [
+  JSON.stringify({
+    id: 'MCPTEST1',
+    project: 'Council Task Board',
+    title: 'verify mcp list',
+    status: 'todo',
+    priority: 1,
+    created_at: Date.now() - 1000,
+    updated_at: Date.now() - 1000,
+  }),
+  JSON.stringify({
+    id: 'MCPTEST2',
+    project: 'Other',
+    title: 'archived item',
+    status: 'done',
+    priority: 3,
+    archived: true,
+    created_at: Date.now() - 2000,
+    updated_at: Date.now() - 2000,
+  }),
+].join('\n') + '\n');
+
+const server = require(path.join(root, 'mcp', 'council-task-board-server.js'));
+
+let r = server.handleMessage({ jsonrpc: '2.0', id: 1, method: 'initialize', params: {} });
+assert.equal(r.result.serverInfo.name, 'council-task-board');
+assert.ok(r.result.capabilities.tools);
+
+r = server.handleMessage({ jsonrpc: '2.0', id: 2, method: 'tools/list', params: {} });
+assert.ok(r.result.tools.some(t => t.name === 'council_tasks_list'));
+assert.ok(r.result.tools.some(t => t.name === 'council_task_action'));
+
+r = server.handleMessage({
+  jsonrpc: '2.0',
+  id: 3,
+  method: 'tools/call',
+  params: { name: 'council_tasks_list', arguments: { project: 'Council Task Board', limit: 5 } },
+});
+let payload = JSON.parse(r.result.content[0].text);
+assert.equal(payload.tasks.length, 1);
+assert.equal(payload.tasks[0].id, 'MCPTEST1');
+
+r = server.handleMessage({
+  jsonrpc: '2.0',
+  id: 4,
+  method: 'tools/call',
+  params: { name: 'council_task_get', arguments: { id: 'MCPTEST1' } },
+});
+payload = JSON.parse(r.result.content[0].text);
+assert.equal(payload.task.title, 'verify mcp list');
+
+r = server.handleMessage({ jsonrpc: '2.0', id: 5, method: 'resources/read', params: { uri: 'council://tasks/current' } });
+payload = JSON.parse(r.result.contents[0].text);
+assert.equal(payload.tasks[0].id, 'MCPTEST1');
+
+assert.equal(server.handleMessage({ jsonrpc: '2.0', method: 'notifications/initialized' }), null);
+r = server.handleMessage({ jsonrpc: '2.0', id: 6, method: 'prompts/list', params: {} });
+assert.deepEqual(r.result.prompts, []);
+
+const framed = server.frameMessage({ jsonrpc: '2.0', id: 7, result: { ok: true } });
+assert.ok(/^Content-Length: \d+\r\n\r\n/.test(framed));
+assert.ok(framed.endsWith('{"jsonrpc":"2.0","id":7,"result":{"ok":true}}'));
+
+console.log('verify-council-task-board-mcp: 11/11 pass');
