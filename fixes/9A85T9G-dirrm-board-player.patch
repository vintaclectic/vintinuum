 let PRIO = 3;
 let VIEW = 'active'; // 'active' | 'archive'
 
+const DIRRM_PLAYER_URL = 'https://vintaclectic.github.io/vintinuum/dirrm-player.html';
+const DIRRM_MODES = ['pip','mini','main','theater'];
+let DIRRM = { mode: localStorage.getItem('dirrmBoard:mode') || 'pip', url: '', title: '', type: '', drag: null };
+
+function dirrmSrc({ url = '', title = '', type = '', mode = DIRRM.mode } = {}) {
+  const qs = new URLSearchParams();
+  if (url) qs.set('url', url);
+  if (title) qs.set('title', title);
+  if (type) qs.set('type', type);
+  if (DIRRM_MODES.includes(mode)) qs.set('mode', mode);
+  qs.set('autoplay', '1');
+  return DIRRM_PLAYER_URL + '?' + qs.toString();
+}
+function dirrmSetStatus(text) {
+  const el = document.getElementById('dirrmLiveState');
+  if (el) el.textContent = text;
+}
+function dirrmSetMode(mode, send = true) {
+  if (!DIRRM_MODES.includes(mode)) mode = 'pip';
+  DIRRM.mode = mode;
+  localStorage.setItem('dirrmBoard:mode', mode);
+  document.querySelectorAll('#dirrmModes .dirrm-chip[data-mode]').forEach(b => b.classList.toggle('on', b.dataset.mode === mode));
+  if (send) {
+    const frame = document.getElementById('dirrmFrame');
+    try { frame?.contentWindow?.postMessage({ action: 'setMode', mode }, '*'); } catch {}
+  }
+}
+function dirrmCurrentPayload() {
+  const raw = (document.getElementById('dirrmUrl')?.value || '').trim();
+  let url = raw;
+  if (url && !/^[a-z][a-z0-9+.-]*:/i.test(url)) url = 'https://' + url;
+  const title = (document.getElementById('dirrmTitle')?.value || '').trim() || url;
+  const type = (document.getElementById('dirrmType')?.value || '').trim();
+  return { url, title, type, mode: DIRRM.mode };
+}
+function dirrmLaunchBoard() {
+  const payload = dirrmCurrentPayload();
+  if (!payload.url) {
+    dirrmSetStatus('Paste a URL first.');
+    document.getElementById('dirrmUrl')?.focus();
+    return;
+  }
+  DIRRM = { ...DIRRM, ...payload };
+  localStorage.setItem('dirrmBoard:lastUrl', payload.url);
+  localStorage.setItem('dirrmBoard:lastTitle', payload.title || '');
+  localStorage.setItem('dirrmBoard:lastType', payload.type || '');
+  const frame = document.getElementById('dirrmFrame');
+  const pip = document.getElementById('dirrmPip');
+  const title = document.getElementById('dirrmPipTitle');
+  if (title) title.textContent = payload.title || 'DirRM Player';
+  if (frame) frame.src = dirrmSrc(payload);
+  if (pip) pip.hidden = false;
+  dirrmSetStatus('Playing in board PiP. Drag the title bar or resize the corner.');
+}
+function dirrmOpenTab() {
+  const payload = dirrmCurrentPayload();
+  if (!payload.url) { dirrmSetStatus('Paste a URL first.'); return; }
+  window.open(dirrmSrc(payload), '_blank', 'noopener');
+}
+function initDirrmBoardPlayer() {
+  const toggle = document.getElementById('btnDirrmToggle');
+  const panel = document.getElementById('dirrmPanel');
+  const url = document.getElementById('dirrmUrl');
+  const title = document.getElementById('dirrmTitle');
+  const type = document.getElementById('dirrmType');
+  if (url) url.value = localStorage.getItem('dirrmBoard:lastUrl') || '';
+  if (title) title.value = localStorage.getItem('dirrmBoard:lastTitle') || '';
+  if (type) type.value = localStorage.getItem('dirrmBoard:lastType') || '';
+  dirrmSetMode(DIRRM.mode, false);
+  toggle?.addEventListener('click', () => {
+    const open = panel?.hidden;
+    if (panel) panel.hidden = !open;
+    toggle.classList.toggle('on', !!open);
+    if (open) setTimeout(() => url?.focus(), 50);
+  });
+  document.getElementById('dirrmLaunch')?.addEventListener('click', dirrmLaunchBoard);
+  document.getElementById('dirrmOpenTab')?.addEventListener('click', dirrmOpenTab);
+  document.querySelectorAll('#dirrmModes .dirrm-chip[data-mode]').forEach(b => b.addEventListener('click', () => dirrmSetMode(b.dataset.mode)));
+  document.getElementById('dirrmToMini')?.addEventListener('click', () => dirrmSetMode('mini'));
+  document.getElementById('dirrmToMain')?.addEventListener('click', () => dirrmSetMode('main'));
+  document.getElementById('dirrmClose')?.addEventListener('click', () => {
+    const pip = document.getElementById('dirrmPip');
+    const frame = document.getElementById('dirrmFrame');
+    try { frame?.contentWindow?.postMessage({ action: 'close' }, '*'); } catch {}
+    if (frame) frame.removeAttribute('src');
+    if (pip) pip.hidden = true;
+    dirrmSetStatus('Player closed.');
+  });
+  [url, title].forEach(el => el?.addEventListener('keydown', e => {
+    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') dirrmLaunchBoard();
+  }));
+  const head = document.getElementById('dirrmPipHead');
+  head?.addEventListener('pointerdown', e => {
+    if (e.target.closest('button')) return;
+    const pip = document.getElementById('dirrmPip'); if (!pip) return;
+    const r = pip.getBoundingClientRect();
+    DIRRM.drag = { dx: e.clientX - r.left, dy: e.clientY - r.top };
+    head.setPointerCapture?.(e.pointerId);
+  });
+  head?.addEventListener('pointermove', e => {
+    if (!DIRRM.drag) return;
+    const pip = document.getElementById('dirrmPip'); if (!pip) return;
+    const w = pip.offsetWidth, h = pip.offsetHeight;
+    const x = Math.max(0, Math.min(window.innerWidth - w, e.clientX - DIRRM.drag.dx));
+    const y = Math.max(0, Math.min(window.innerHeight - h, e.clientY - DIRRM.drag.dy));
+    pip.style.left = x + 'px'; pip.style.top = y + 'px'; pip.style.right = 'auto'; pip.style.bottom = 'auto';
+  });
+  head?.addEventListener('pointerup', e => { DIRRM.drag = null; try { head.releasePointerCapture?.(e.pointerId); } catch {} });
+}
