+  if(!b) return;
+  GALAXY_MODE=b.dataset.galaxy||'active';
+  galaxyControls.querySelectorAll('.galaxy-chip').forEach(x=>x.classList.toggle('on', x===b));
+  renderGalaxy(TASK_CACHE);
+});
+const galaxyStage = document.getElementById('galaxyStage');
