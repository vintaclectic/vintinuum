+
+function galaxyPool(tasks){
+  const list = Array.isArray(tasks) ? tasks.slice() : [];
+  if(GALAXY_MODE==='all') return list.filter(t=>t.status!=='cancelled').slice(0,42);
+  if(GALAXY_MODE==='review') return list.filter(t=>['needs-human','blocked'].includes(t.status) && !t.archived).slice(0,42);
+  if(GALAXY_MODE==='done') return list.filter(t=>t.status==='done').sort((a,b)=>(b.updated_at||0)-(a.updated_at||0)).slice(0,42);
+  return list.filter(t=>!t.archived && !['cancelled','done'].includes(t.status)).slice(0,42);
+}
+function galaxyLinkReason(a,b){
+  if(a.project && b.project && a.project===b.project) return 'project';
+  const aa=a.chosen_agent||a.assignee, bb=b.chosen_agent||b.assignee;
+  if(aa && bb && aa===bb) return 'agent';
+  if(a.status && a.status===b.status) return 'status';
+  return '';
+}
+function renderGalaxy(tasks){
+  const sys=document.getElementById('galaxySystem'), lines=document.getElementById('galaxyLines');
+  if(!sys || !lines) return;
+  const pool=galaxyPool(tasks);
+  const open=(tasks||[]).filter(t=>!t.archived && !['done','cancelled'].includes(t.status)).length;
+  const done=(tasks||[]).filter(t=>t.status==='done').length;
+  const review=(tasks||[]).filter(t=>['needs-human','blocked'].includes(t.status) && !t.archived).length;
+  const stats=document.getElementById('galaxyStats');
+  if(stats) stats.innerHTML=[
+    `<div class="galaxy-stat"><b>${open}</b><span>open</span></div>`,
+    `<div class="galaxy-stat"><b>${review}</b><span>decision stars</span></div>`,
+    `<div class="galaxy-stat"><b>${done}</b><span>completed</span></div>`
+  ].join('');
+  const core=document.getElementById('galaxyCore');
+  if(core) core.innerHTML=`<span><b>${pool.length}</b>bodies</span>`;
+  if(!pool.length){
+    lines.innerHTML='';
+    sys.innerHTML='<div class="galaxy-empty"><div><b>No bodies in this constellation.</b><br>Switch modes or queue work to seed the star field.</div></div>';
+    return;
+  }
+  const w=1000,h=560,cx=500,cy=280;
+  const placed=pool.map((t,i)=>{
+    const orbit = 120 + (i%3)*92;
+    const theta = (i*137.508 + ((t.priority||3)*19)) * Math.PI/180;
+    const x = cx + Math.cos(theta)*orbit*(1 + ((i%5)-2)*.025);
+    const y = cy + Math.sin(theta)*orbit*.78;
+    return {t,x:Math.max(80,Math.min(w-80,x)),y:Math.max(70,Math.min(h-70,y))};
+  });
+  const edge=[];
+  for(let i=0;i<placed.length;i++){
+    for(let j=i+1;j<placed.length && edge.length<70;j++){
+      const why=galaxyLinkReason(placed[i].t, placed[j].t);
+      if(why) edge.push(`<line x1="${placed[i].x.toFixed(1)}" y1="${placed[i].y.toFixed(1)}" x2="${placed[j].x.toFixed(1)}" y2="${placed[j].y.toFixed(1)}" data-kind="${why}"></line>`);
+    }
+  }
+  lines.innerHTML=edge.join('');
+  sys.innerHTML=placed.map(p=>{
+    const t=p.t, age=ago(t.updated_at||t.created_at||Date.now());
+    const agent=t.chosen_agent||t.assignee||'council';
+    return `<button type="button" class="planet s-${esc(t.status||'todo')}" data-open="${esc(t.id)}"
+        style="left:${(p.x/w*100).toFixed(2)}%;top:${(p.y/h*100).toFixed(2)}%"
+        title="${esc(t.title||t.id)} — open task">
+      <span class="planet-name">${esc(t.title||t.id)}</span>
+      <span class="planet-meta"><span>${esc(t.id)}</span><span>${esc(t.status||'todo')}</span><span>${esc(agent)}</span><span>${esc(age)}</span></span>
+    </button>`;
+  }).join('');
+}
+
